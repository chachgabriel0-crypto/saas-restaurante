# ============================================================
# Variables de entorno — Restaurante POS SaaS
# IMPORTANTE: Renombra este archivo a .env (sin el .example)
# NUNCA subas el archivo .env a Git — solo el .env.example
# ============================================================

# ---- SUPABASE ----
# Obtén estos valores en: Supabase → Settings → API

# URL de tu proyecto Supabase (termina en .supabase.co)
VITE_SUPABASE_URL=https://XXXXXXXXXXXXXXXXXX.supabase.co

# Clave pública (anon key) — es segura ponerla en el frontend
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...TU_ANON_KEY_AQUI

# ============================================================
# Para Vercel: agrega estas mismas variables en:
# Vercel Dashboard → Tu proyecto → Settings → Environment Variables
# ============================================================
